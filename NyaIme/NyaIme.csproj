<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android36.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<ApplicationId>com.companyname.Nyalme</ApplicationId>
		<ApplicationVersion>7</ApplicationVersion>
		<ApplicationDisplayVersion>1.6</ApplicationDisplayVersion>

		<TrimMode>full</TrimMode>
		<Platforms>AnyCPU;ARM32;x86</Platforms>

		<AndroidPackageFormats>apk</AndroidPackageFormats>
	</PropertyGroup>

	<Target Name="CreateApkAfterVisualStudioBuild"
			AfterTargets="Build"
			Condition="'$(BuildingInsideVisualStudio)' == 'true' and '$(Configuration)' == 'Release'"
			DependsOnTargets="SignAndroidPackage" />

</Project>
